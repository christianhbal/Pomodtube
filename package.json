{
  "name": "foco",
  "version": "0.1.0",
  "private": true,
  "description": "Pomodoro con video de YouTube. Monorepo: app móvil + API.",
  "workspaces": [
    "apps/mobile",
    "apps/backend"
  ],
  "scripts": {
    "mobile": "npm run start -w @foco/mobile",
    "mobile:android": "npm run android -w @foco/mobile",
    "mobile:ios": "npm run ios -w @foco/mobile",
    "mobile:web": "npm run web -w @foco/mobile",
    "backend": "npm run dev -w @foco/backend",
    "backend:build": "npm run build -w @foco/backend",
    "backend:start": "npm run start -w @foco/backend",
    "typecheck": "npm run typecheck -w @foco/mobile && npm run typecheck -w @foco/backend",
    "lint": "npm run lint -w @foco/mobile"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
