# Copiá este archivo a .env y completá los valores.
# El .env NUNCA se commitea.

NODE_ENV=development
HOST=127.0.0.1
# En Render/Fly/Railway usá HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Orígenes permitidos por CORS, separados por coma.
# En producción agregá la URL de la web (Vercel/Cloudflare).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo backend. Nunca la pongas en la app.
SUPABASE_SERVICE_ROLE_KEY=

# Código para el registro. Si queda vacío, el registro se cierra.
SIGNUP_CODE=
